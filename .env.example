GROQ_API_KEY=

# Canonical production origin, for example https://portfolio.example.com
NEXT_PUBLIC_SITE_URL=https://portfolio-jade-six-ys9gex8x7k.vercel.app

# Existing contact form configuration
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# On Vercel, use x-real-ip: Vercel rewrites it with the public client IP.
# Leave blank for local development; required on hosted deployments for the limiter.
CHAT_TRUSTED_IP_HEADER=

# Optional local mock endpoint. It is honored only with GROQ_MOCK_MODE=1 and never on Vercel.
GROQ_BASE_URL=
GROQ_MOCK_MODE=

# Optional provider timeout override for controlled tests or operations.
# Defaults are 8 seconds for routing/planning and 15 seconds for generation.
GROQ_TIMEOUT_MS=
